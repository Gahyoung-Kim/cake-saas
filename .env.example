# 프론트엔드 API 주소 (빌드 시점에 주입됨 — 배포 도메인으로 교체)
VITE_API_URL=http://localhost:8000

# AI 주문 추출 (기본: OpenAI gpt-4o-mini)
OPENAI_API_KEY=
# 추후 Claude 전환 대비 — 현재는 사용하지 않음
ANTHROPIC_API_KEY=

DATABASE_URL=mysql+pymysql://caker:caker@localhost:3306/cakesaas

# 필수값 — 미설정 시 서버가 기동되지 않는다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS 허용 오리진 (쉼표 구분). 배포 시 실제 도메인으로 교체
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
