# ── 프론트엔드 ────────────────────────────────────────────────────────────
# 빌드 시점에 주입된다. frontend/.env.production 에 두거나 빌드 환경변수로 전달.
# 프론트와 API를 같은 도메인에 두고 nginx로 /api를 프록시하면 빈 값으로 둬도 된다.
VITE_API_URL=http://localhost:8000

# ── AI 주문 추출 ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 데이터베이스 ──────────────────────────────────────────────────────────
# 운영에서는 root가 아니라 해당 DB 권한만 가진 전용 계정을 쓸 것.
DATABASE_URL=mysql+pymysql://caker:caker@localhost:3306/cakesaas

# ── 인증 ──────────────────────────────────────────────────────────────────
# 필수값 — 미설정 시 서버가 기동되지 않는다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────────────────
# 쉼표 구분. 배포 시 실제 도메인으로 교체.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 요청 빈도 제한 ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# 워커를 2개 이상 띄우면 카운트가 워커별로 나뉘므로 Redis를 지정해야 한다.
# 예: redis://localhost:6379
RATE_LIMIT_STORAGE_URI=

# ── 운영 ─────────────────────────────────────────────────────────────────
# 운영에서는 false — API 스펙(/docs, /redoc, /openapi.json)을 공개하지 않는다.
ENABLE_DOCS=true
